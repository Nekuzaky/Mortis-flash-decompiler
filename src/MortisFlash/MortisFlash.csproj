<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Precompiled code in published builds: faster startup and no JIT pauses on first use -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <RootNamespace>MortisFlash</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Product>MortisFlash</Product>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <!-- Embedded Flash player: Ruffle (MIT / Apache-2.0), stored inside the executable and served from memory -->
  <ItemGroup>
    <EmbeddedResource Include="Ruffle\**" LogicalName="Ruffle/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MortisFlash.Core\MortisFlash.Core.csproj" />
  </ItemGroup>
  <!-- Only Microsoft.Web.WebView2.Core is used: drop the package's WPF / WinForms references (WindowsBase conflict) -->
  <Target Name="DropWebView2UiReferences" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
    </ItemGroup>
  </Target>
</Project>
